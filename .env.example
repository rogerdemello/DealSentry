# Database Configuration
# PostgreSQL connection string for Supabase or your own PostgreSQL instance
DATABASE_URL="postgresql://postgres:password@localhost:5432/dealsentry"

# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Azure OpenAI Configuration (for AI-powered features)
# Required for proposal analysis and AI generation
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/"
OPENAI_API_KEY="your-azure-openai-api-key-here"
AZURE_OPENAI_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_API_VERSION="2024-12-01-preview"
# Embedding deployment — required only for semantic search (Phase 4)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-ada-002"

# Email Notifications (Optional)
# Sending is OFF unless EMAIL_ENABLED="true" AND a provider key is set.
# Default provider is Resend (https://resend.com).
EMAIL_ENABLED="false"
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM="DealSentry <noreply@dealsentry.ai>"

# Authentication
# Secret key for JWT token signing - CHANGE THIS IN PRODUCTION!
NEXTAUTH_SECRET="change-this-to-a-random-secure-string-in-production"

# API Configuration
# Port for the Express API server
API_PORT=3001

# Frontend URL (for OAuth callbacks)
FRONTEND_URL="http://localhost:8080"

# Production URL (for CORS in production environment)
# Only this domain will be allowed to make API requests in production
PRODUCTION_URL="https://your-production-domain.com"

# Integration Configuration (Optional)
# Demo mode allows testing integrations without real credentials
# Set to "false" and provide real credentials for production

# Salesforce
SALESFORCE_DEMO_MODE="true"
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
SALESFORCE_SANDBOX="false"

# HubSpot
HUBSPOT_DEMO_MODE="false"
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""

# Google (for Gmail integration)
GMAIL_DEMO_MODE="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Development Server Configuration
# Optional: set only if the API is served from a different origin than the Vite app.
# Leave unset (or commented) for local dev so the browser uses same-origin /api/* URLs and
# Vite proxies to Express (works for both localhost and 127.0.0.1).
# VITE_API_URL=http://localhost:3001
